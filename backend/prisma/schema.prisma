generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stories             Story[]
  characters          Character[]
  relationships       Relationship[]
  locations           Location[]
  events              PlotEvent[]
  chapters            Chapter[]
  notes               Note[]
  unresolvedQuestions UnresolvedQuestion[]
  appSettings         AppSettings?
}

model Story {
  id           String   @id @default(uuid())
  userId       String
  title        String
  summary      String   @db.Text
  theme        String?  @db.Text
  coreQuestion String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  characters          Character[]
  relationships       Relationship[]
  locations           Location[]
  events              PlotEvent[]
  chapters            Chapter[]
  notes               Note[]
  unresolvedQuestions UnresolvedQuestion[]
}

model Character {
  id          String   @id @default(uuid())
  userId      String
  storyId     String
  name        String
  role        String
  description String   @db.Text
  traits      String[]
  arcLie      String?  @db.Text
  arcTruth    String?  @db.Text
  arcGhost    String?  @db.Text
  avatarUrl   String?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  events PlotEvent[] @relation("CharacterEvents")
}

model Relationship {
  id          String @id @default(uuid())
  userId      String
  storyId     String
  sourceId    String
  targetId    String
  type        String
  description String @db.Text

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
}

model Location {
  id           String  @id @default(uuid())
  userId       String
  storyId      String
  name         String
  description  String  @db.Text
  sensorySight String? @db.Text
  sensorySound String? @db.Text
  sensorySmell String? @db.Text
  sensoryTouch String? @db.Text
  sensoryTaste String? @db.Text

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  story  Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  events PlotEvent[]
}

model PlotEvent {
  id             String  @id @default(uuid())
  userId         String
  storyId        String
  title          String
  description    String  @db.Text
  order          Int
  chapterId      String?
  locationId     String?
  status         String?
  plotThread     String?
  emotionalValue Int?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  story      Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapter    Chapter?    @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  location   Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  characters Character[] @relation("CharacterEvents")
}

model Chapter {
  id      String @id @default(uuid())
  userId  String
  storyId String
  title   String
  content String @db.Text
  order   Int
  status  String

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  story  Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  events PlotEvent[]
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  storyId   String
  content   String   @db.Text
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
}

model UnresolvedQuestion {
  id         String   @id @default(uuid())
  userId     String
  storyId    String
  question   String   @db.Text
  details    String   @db.Text
  isResolved Boolean  @default(false)
  answer     String?  @db.Text
  createdAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
}

model AppSettings {
  id          String  @id @default(uuid())
  userId      String  @unique
  llmProvider String  @default("gemini")
  geminiKey   String?
  geminiModel String?
  openaiKey   String?
  theme       String  @default("system")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tombstone {
  id         String   @id @default(uuid())
  entityId   String
  entityType String
  deletedAt  DateTime @default(now())
}
